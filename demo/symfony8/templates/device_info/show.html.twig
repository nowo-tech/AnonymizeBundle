{% extends 'base.html.twig' %}

{% block title %}Device Info Details - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Device Infos', isMongo: true, routePrefix: 'mongodb_device_info', currentPage: 'Show'} %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This MongoDB document demonstrates technical fakers: uuid, ip_address, mac_address, hash, coordinate, color.
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Device Info Details <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('mongodb_device_info_edit', {id: device._id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('mongodb_device_info_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value"><code>{{ device._id }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Device ID (UUID)</dt><dd class="nowo-ui-detail-list__value"><code>{{ device.deviceId }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">IP Address</dt><dd class="nowo-ui-detail-list__value">{{ device.ipAddress }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">MAC Address</dt><dd class="nowo-ui-detail-list__value"><code>{{ device.macAddress }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Device Hash</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ device.deviceHash ?? '-' }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Location (Coordinates)</dt><dd class="nowo-ui-detail-list__value">{{ device.location ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Theme Color</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral" style="background-color: {{ device.themeColor }}">{{ device.themeColor }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Device Name</dt><dd class="nowo-ui-detail-list__value">{{ device.deviceName ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">OS Version</dt><dd class="nowo-ui-detail-list__value">{{ device.osVersion ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Browser Version</dt><dd class="nowo-ui-detail-list__value">{{ device.browserVersion ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Is Active</dt><dd class="nowo-ui-detail-list__value">
                {% if device.isActive|default(false) %}
                    <span class="nowo-ui-badge nowo-ui-badge--success">Yes</span>
                {% else %}
                    <span class="nowo-ui-badge nowo-ui-badge--neutral">No</span>
                {% endif %}
            </dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Last Seen</dt><dd class="nowo-ui-detail-list__value">{{ device.lastSeen ? device.lastSeen.toDateTime()|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if device.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: device.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
        </dl>

        <div>
            {% set delete_form = demo_delete_form('mongodb_device_info_delete', {id: device._id}, device._id, 'Are you sure you want to delete this device?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Device', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
