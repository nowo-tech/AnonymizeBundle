{% extends 'base.html.twig' %}

{% block title %}Device Info Details - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_device_info_edit', {id: device._id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a> <a href="{{ path('mongodb_device_info_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Device Info Details', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This MongoDB document demonstrates technical fakers: uuid, ip_address, mac_address, hash, coordinate, color.</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ device._id }}</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Device ID (UUID)</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ device.deviceId }}</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">IP Address</dt><dd class="nowo-ui-detail-list__value">{{ device.ipAddress }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">MAC Address</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ device.macAddress }}</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Device Hash</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ device.deviceHash ?? '-' }}</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Location (Coordinates)</dt><dd class="nowo-ui-detail-list__value">{{ device.location ?? '-' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Theme Color</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ device.themeColor }}</span></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Device Name</dt><dd class="nowo-ui-detail-list__value">{{ device.deviceName ?? '-' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">OS Version</dt><dd class="nowo-ui-detail-list__value">{{ device.osVersion ?? '-' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Browser Version</dt><dd class="nowo-ui-detail-list__value">{{ device.browserVersion ?? '-' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Is Active</dt><dd class="nowo-ui-detail-list__value">
                    {% if device.isActive|default(false) %}
                        <span class="nowo-ui-badge nowo-ui-badge--success">Yes</span>
                    {% else %}
                        <span class="nowo-ui-badge nowo-ui-badge--neutral">No</span>
                    {% endif %}
                </dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Last Seen</dt><dd class="nowo-ui-detail-list__value">{{ device.lastSeen ? device.lastSeen.toDateTime()|date('Y-m-d H:i:s') : '-' }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                    {% if device.anonymized|default(false) %}
                                        {% include '_anonymized_badge.html.twig' with {value: device.anonymized|default(false)} %}
                                    {% endif %}
                </dd></div>
            </dl>
        {% endblock %}
        {% block section_footer %}
            {% set delete_form = demo_delete_form('mongodb_device_info_delete', {id: device._id}, device._id) %}
            {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (device._id), message: 'Are you sure you want to delete this device?', label: 'Delete Device'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
