{% extends 'base.html.twig' %}

{% block title %}Device Infos - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_device_info_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Device Infos', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This MongoDB document demonstrates technical fakers:
            </p>
            <ul>
                    <li><strong>deviceId</strong> - UUID faker</li>
                    <li><strong>ipAddress</strong> - IP address faker</li>
                    <li><strong>macAddress</strong> - MAC address faker</li>
                    <li><strong>deviceHash</strong> - Hash faker</li>
                    <li><strong>location</strong> - Coordinate faker</li>
                    <li><strong>themeColor</strong> - Color faker</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Device Infos', kind: 'table', empty: not (devices|length > 0), state_message: 'No device infos found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Device ID</th>
                        <th>Device Name</th>
                        <th>IP Address</th>
                        <th>MAC Address</th>
                        <th>Is Active</th>
                        <th>Last Seen</th>
                        <th>Anonymized</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for device in devices %}
                    <tr>
                        <td><code class="nowo-ui-code">{{ device._id|slice(0, 8) }}...</code></td>
                        <td><code class="nowo-ui-code">{{ device.deviceId|slice(0, 8) }}...</code></td>
                        <td>{{ device.deviceName ?? '-' }}</td>
                        <td>{{ device.ipAddress }}</td>
                        <td><code class="nowo-ui-code">{{ device.macAddress }}</code></td>
                        <td>
                            {% if device.isActive|default(false) %}
                                <span class="nowo-ui-badge nowo-ui-badge--success">Yes</span>
                            {% else %}
                                <span class="nowo-ui-badge nowo-ui-badge--neutral">No</span>
                            {% endif %}
                        </td>
                        <td>{{ device.lastSeen ? device.lastSeen.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            {% if device.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: device.anonymized|default(false)} %}
                            {% endif %}
                        </td>
                        <td>
                            <div class="nowo-ui-row-actions">
                                <a href="{{ path('mongodb_device_info_show', {id: device._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                <a href="{{ path('mongodb_device_info_edit', {id: device._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                {% set delete_form = demo_delete_form('mongodb_device_info_delete', {id: device._id}, device._id) %}

                                {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (device._id), message: 'Are you sure you want to delete this item?', size: 'sm'} only %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

{% endblock %}
