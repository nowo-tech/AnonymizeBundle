{% extends 'base.html.twig' %}

{% block title %}Person Details - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('person_edit', {connection: connection, id: person.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a> <a href="{{ path('person_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Person Details', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ person.id }}</dd></div>
                {% for field in person|keys %}
                    {% if field != 'id' and field != 'anonymized' %}
                    <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ field|replace({'_': ' '})|title }}</dt><dd class="nowo-ui-detail-list__value">{{ person[field] ?? '-' }}</dd></div>
                    {% endif %}
                {% endfor %}
                {% if hasAnonymizedColumn|default(false) %}
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                    {% if person.anonymized|default(false) %}
                    {% include '_anonymized_badge.html.twig' with {value: person.anonymized|default(false)} %}
                    {% endif %}
                </dd></div>
                {% endif %}
            </dl>
        {% endblock %}
        {% block section_footer %}
            {% set delete_form = demo_delete_form('person_delete', {connection: connection, id: person.id}, person.id) %}
            {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (person.id), message: 'Are you sure you want to delete this person?', label: 'Delete Person'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
