{% extends 'base.html.twig' %}

{% block title %}New Transaction Log - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Transaction Logs', isMongo: true, routePrefix: 'mongodb_transaction_log', currentPage: 'New'} %}
<div class="mb-3">
    <a href="{{ path('mongodb_transaction_log_index') }}" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
        </svg>
        Back to List
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-header">
        <h2 class="mb-0">Create New Transaction Log <span class="badge bg-info connection-badge">MongoDB</span></h2>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            {{ include('_form_fields.html.twig', {form: form, columns: {
                transactionId: 'col-md-6',
                customerEmail: 'col-md-6',
                iban: 'col-md-6',
                creditCard: 'col-md-6',
                maskedCard: 'col-md-6',
                transactionHash: 'col-md-6',
                amount: 'col-md-6',
                currency: 'col-md-6',
                status: 'col-md-6',
                transactionDate: 'col-md-6'
            }}) }}

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a href="{{ path('mongodb_transaction_log_index') }}" class="btn btn-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
