{% extends 'base.html.twig' %}

{% block title %}Transaction Logs - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Transaction Logs', isMongo: true, routePrefix: 'mongodb_transaction_log', currentPage: 'List'} %}
{% if error|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--error" role="alert">
    <strong>⚠️ Error:</strong> {{ error }}
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This MongoDB document demonstrates financial fakers:
    <ul>
        <li><strong>customerEmail</strong> - Email faker</li>
        <li><strong>iban</strong> - IBAN faker</li>
        <li><strong>creditCard</strong> - Credit card faker</li>
        <li><strong>maskedCard</strong> - Masking faker (preserve last 4 digits)</li>
        <li><strong>amount</strong> - Numeric faker</li>
        <li><strong>transactionHash</strong> - Hash faker</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Transaction Logs <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
        <a href="{{ path('mongodb_transaction_log_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if transactions|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Transaction ID</th>
                            <th>Customer Email</th>
                            <th>Amount</th>
                            <th>Currency</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Anonymized</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for transaction in transactions %}
                        <tr>
                            <td><code class="nowo-ui-code">{{ transaction._id|slice(0, 8) }}...</code></td>
                            <td><code class="nowo-ui-code">{{ transaction.transactionId|slice(0, 12) }}...</code></td>
                            <td>{{ transaction.customerEmail }}</td>
                            <td>{{ transaction.amount|number_format(2, '.', ',') }} {{ transaction.currency }}</td>
                            <td>{{ transaction.currency }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--{{ transaction.status == 'completed' ? 'success' : (transaction.status == 'failed' ? 'danger' : (transaction.status == 'refunded' ? 'warning' : 'info')) }}">{{ transaction.status }}</span></td>
                            <td>{{ transaction.transactionDate ? transaction.transactionDate.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                            <td>
                                {% if transaction.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: transaction.anonymized|default(false)} %}
                                {% endif %}
                            </td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('mongodb_transaction_log_show', {id: transaction._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('mongodb_transaction_log_edit', {id: transaction._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('mongodb_transaction_log_delete', {id: transaction._id}, transaction._id, 'Are you sure you want to delete this item?') %}
                                    {{ form_start(delete_form) }}
                                    {{ form_end(delete_form) }}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No transaction logs found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
