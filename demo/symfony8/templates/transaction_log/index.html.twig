{% extends 'base.html.twig' %}

{% block title %}Transaction Logs - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_transaction_log_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Transaction Logs', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This MongoDB document demonstrates financial fakers:
            </p>
            <ul>
                    <li><strong>customerEmail</strong> - Email faker</li>
                    <li><strong>iban</strong> - IBAN faker</li>
                    <li><strong>creditCard</strong> - Credit card faker</li>
                    <li><strong>maskedCard</strong> - Masking faker (preserve last 4 digits)</li>
                    <li><strong>amount</strong> - Numeric faker</li>
                    <li><strong>transactionHash</strong> - Hash faker</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Transaction Logs', kind: 'table', empty: not (transactions|length > 0), state_message: 'No transaction logs found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Transaction ID</th>
                        <th>Customer Email</th>
                        <th>Amount</th>
                        <th>Currency</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Anonymized</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for transaction in transactions %}
                    <tr>
                        <td><code class="nowo-ui-code">{{ transaction._id|slice(0, 8) }}...</code></td>
                        <td><code class="nowo-ui-code">{{ transaction.transactionId|slice(0, 12) }}...</code></td>
                        <td>{{ transaction.customerEmail }}</td>
                        <td>{{ transaction.amount|number_format(2, '.', ',') }} {{ transaction.currency }}</td>
                        <td>{{ transaction.currency }}</td>
                        <td><span class="nowo-ui-badge nowo-ui-badge--{{ transaction.status == 'completed' ? 'success' : (transaction.status == 'failed' ? 'danger' : (transaction.status == 'refunded' ? 'warning' : 'info')) }}">{{ transaction.status }}</span></td>
                        <td>{{ transaction.transactionDate ? transaction.transactionDate.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            {% if transaction.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: transaction.anonymized|default(false)} %}
                            {% endif %}
                        </td>
                        <td>
                            <div class="nowo-ui-row-actions">
                                <a href="{{ path('mongodb_transaction_log_show', {id: transaction._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                <a href="{{ path('mongodb_transaction_log_edit', {id: transaction._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                {% set delete_form = demo_delete_form('mongodb_transaction_log_delete', {id: transaction._id}, transaction._id) %}

                                {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (transaction._id), message: 'Are you sure you want to delete this item?', size: 'sm'} only %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

{% endblock %}
