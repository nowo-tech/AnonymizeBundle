{% extends 'base.html.twig' %}

{% block title %}New Contact - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Contact', connection: connection, routePrefix: 'contact', currentPage: 'New'} %}

<p><a href="{{ path('contact_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a></p>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Create New Contact <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form, {'attr': {'novalidate': true}}) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            <div class="nowo-ui-form__actions">
                {{ form_row(form.save, {label: 'Create Contact'}) }}
                <a href="{{ path('contact_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
