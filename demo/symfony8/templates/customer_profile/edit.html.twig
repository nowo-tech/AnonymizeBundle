{% extends 'base.html.twig' %}

{% block title %}Edit Customer Profile - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Customer Profiles', isMongo: true, routePrefix: 'mongodb_customer_profile', currentPage: 'Edit'} %}
<div class="mb-3">
    <a href="{{ path('mongodb_customer_profile_index') }}" class="btn btn-outline-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
        </svg>
        Back to List
    </a>
</div>
<div class="card shadow-sm">
    <div class="card-header">
        <h2 class="mb-0">Edit Customer Profile <span class="badge bg-info connection-badge">MongoDB</span></h2>
    </div>
    <div class="card-body">
        {{ form_start(form) }}
            {{ include('_form_fields.html.twig', {form: form, columns: {
                email: 'col-md-6',
                username: 'col-md-6',
                firstName: 'col-md-6',
                lastName: 'col-md-6',
                phone: 'col-md-6',
                age: 'col-md-6',
                company: 'col-md-6',
                website: 'col-md-6',
                status: 'col-md-6',
                createdAt: 'col-md-6'
            }}) }}

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Update</button>
                <a href="{{ path('mongodb_customer_profile_index') }}" class="btn btn-secondary">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
