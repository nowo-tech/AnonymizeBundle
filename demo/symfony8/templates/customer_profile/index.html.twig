{% extends 'base.html.twig' %}

{% block title %}Customer Profiles - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_customer_profile_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Customer Profiles', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This MongoDB document demonstrates basic and advanced fakers:
            </p>
            <ul>
                    <li><strong>email</strong> - Email faker</li>
                    <li><strong>firstName</strong> - Name faker</li>
                    <li><strong>lastName</strong> - Surname faker</li>
                    <li><strong>phone</strong> - Phone faker</li>
                    <li><strong>address</strong> - Address faker</li>
                    <li><strong>company</strong> - Company faker</li>
                    <li><strong>username</strong> - Username faker</li>
                    <li><strong>website</strong> - URL faker</li>
                    <li><strong>age</strong> - Age faker</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Customer Profiles', kind: 'table', empty: not (profiles|length > 0), state_message: 'No customer profiles found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Anonymized</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for profile in profiles %}
                    <tr>
                        <td><code class="nowo-ui-code">{{ profile._id|slice(0, 8) }}...</code></td>
                        <td>{{ profile.email }}</td>
                        <td>{{ profile.firstName }} {{ profile.lastName }}</td>
                        <td>{{ profile.company ?? '-' }}</td>
                        <td><span class="nowo-ui-badge nowo-ui-badge--{{ profile.status == 'active' ? 'success' : (profile.status == 'inactive' ? 'warning' : 'neutral') }}">{{ profile.status }}</span></td>
                        <td>{{ profile.createdAt ? profile.createdAt.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            {% if profile.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: profile.anonymized|default(false)} %}
                            {% endif %}
                        </td>
                        <td>
                            <div class="nowo-ui-row-actions">
                                <a href="{{ path('mongodb_customer_profile_show', {id: profile._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                <a href="{{ path('mongodb_customer_profile_edit', {id: profile._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                {% set delete_form = demo_delete_form('mongodb_customer_profile_delete', {id: profile._id}, profile._id) %}

                                {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (profile._id), message: 'Are you sure you want to delete this item?', size: 'sm'} only %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

{% endblock %}
