{% extends 'base.html.twig' %}

{% block title %}Customer Profiles - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Customer Profiles', isMongo: true, routePrefix: 'mongodb_customer_profile', currentPage: 'List'} %}
{% if error|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--error" role="alert">
    <strong>⚠️ Error:</strong> {{ error }}
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This MongoDB document demonstrates basic and advanced fakers:
    <ul>
        <li><strong>email</strong> - Email faker</li>
        <li><strong>firstName</strong> - Name faker</li>
        <li><strong>lastName</strong> - Surname faker</li>
        <li><strong>phone</strong> - Phone faker</li>
        <li><strong>address</strong> - Address faker</li>
        <li><strong>company</strong> - Company faker</li>
        <li><strong>username</strong> - Username faker</li>
        <li><strong>website</strong> - URL faker</li>
        <li><strong>age</strong> - Age faker</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Customer Profiles <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
        <a href="{{ path('mongodb_customer_profile_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if profiles|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Company</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th>Anonymized</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for profile in profiles %}
                        <tr>
                            <td><code class="nowo-ui-code">{{ profile._id|slice(0, 8) }}...</code></td>
                            <td>{{ profile.email }}</td>
                            <td>{{ profile.firstName }} {{ profile.lastName }}</td>
                            <td>{{ profile.company ?? '-' }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--{{ profile.status == 'active' ? 'success' : (profile.status == 'inactive' ? 'warning' : 'neutral') }}">{{ profile.status }}</span></td>
                            <td>{{ profile.createdAt ? profile.createdAt.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                            <td>
                                {% if profile.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: profile.anonymized|default(false)} %}
                                {% endif %}
                            </td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('mongodb_customer_profile_show', {id: profile._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('mongodb_customer_profile_edit', {id: profile._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('mongodb_customer_profile_delete', {id: profile._id}, profile._id, 'Are you sure you want to delete this item?') %}
                                    {{ form_start(delete_form) }}
                                    {{ form_end(delete_form) }}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No customer profiles found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
