{% extends 'base.html.twig' %}

{% block title %}New Customer Profile - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Customer Profiles', isMongo: true, routePrefix: 'mongodb_customer_profile', currentPage: 'New'} %}
<p><a href="{{ path('mongodb_customer_profile_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a></p>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Create New Customer Profile <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form) }}
            {{ include('_form_fields.html.twig', {form: form}) }}

            <div class="nowo-ui-form__actions">
                {{ form_row(form.save, {label: 'Create'}) }}
                <a href="{{ path('mongodb_customer_profile_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
