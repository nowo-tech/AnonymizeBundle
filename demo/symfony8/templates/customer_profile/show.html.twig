{% extends 'base.html.twig' %}

{% block title %}Customer Profile Details - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Customer Profiles', isMongo: true, routePrefix: 'mongodb_customer_profile', currentPage: 'Show'} %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This MongoDB document demonstrates basic and advanced fakers: email, name, surname, phone, address, company, username, url, age.
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Customer Profile Details <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('mongodb_customer_profile_edit', {id: profile._id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('mongodb_customer_profile_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value"><code>{{ profile._id }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Email</dt><dd class="nowo-ui-detail-list__value">{{ profile.email }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">First Name</dt><dd class="nowo-ui-detail-list__value">{{ profile.firstName }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Last Name</dt><dd class="nowo-ui-detail-list__value">{{ profile.lastName }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Phone</dt><dd class="nowo-ui-detail-list__value">{{ profile.phone ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Address</dt><dd class="nowo-ui-detail-list__value">{{ profile.address ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Company</dt><dd class="nowo-ui-detail-list__value">{{ profile.company ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Username</dt><dd class="nowo-ui-detail-list__value">{{ profile.username ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Website</dt><dd class="nowo-ui-detail-list__value">{{ profile.website ? '<a href="' ~ profile.website ~ '" target="_blank">' ~ profile.website ~ '</a>'|raw : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Age</dt><dd class="nowo-ui-detail-list__value">{{ profile.age ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Status</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--{{ profile.status == 'active' ? 'success' : (profile.status == 'inactive' ? 'warning' : 'neutral') }}">{{ profile.status }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Created At</dt><dd class="nowo-ui-detail-list__value">{{ profile.createdAt ? profile.createdAt.toDateTime()|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if profile.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: profile.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
        </dl>

        <div>
            {% set delete_form = demo_delete_form('mongodb_customer_profile_delete', {id: profile._id}, profile._id, 'Are you sure you want to delete this profile?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Profile', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
