{% extends 'base.html.twig' %}

{% block title %}Edit Employee #{{ employee.id }} - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Employees', connection: connection, routePrefix: 'employee', currentPage: 'Edit'} %}
<p><a href="{{ path('employee_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a></p>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Edit Employee <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form, {'attr': {'novalidate': true}}) }}
            {{ include('_form_fields.html.twig', {form: form}) }}

            <div class="nowo-ui-form__actions">
                {{ form_row(form.save, {label: 'Update Employee'}) }}
                <a href="{{ path('employee_show', {connection: connection, id: employee.id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
