{% extends 'base.html.twig' %}

{% block title %}Employee #{{ employee.id }} - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Employees', connection: connection, routePrefix: 'employee', currentPage: 'Show'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Employee Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('employee_edit', {connection: connection, id: employee.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('employee_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ employee.id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">First Name</dt><dd class="nowo-ui-detail-list__value">{{ employee.firstName }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Last Name</dt><dd class="nowo-ui-detail-list__value">{{ employee.lastName }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Username</dt><dd class="nowo-ui-detail-list__value">{{ employee.username }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Email</dt><dd class="nowo-ui-detail-list__value">{{ employee.email }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Phone</dt><dd class="nowo-ui-detail-list__value">{{ employee.phone ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Birth Date</dt><dd class="nowo-ui-detail-list__value">{{ employee.birthDate ? employee.birthDate|date('Y-m-d') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Age</dt><dd class="nowo-ui-detail-list__value">{{ employee.age }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Department</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ employee.department }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Previous Company</dt><dd class="nowo-ui-detail-list__value">{{ employee.previousCompany ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Hire Date</dt><dd class="nowo-ui-detail-list__value">{{ employee.hireDate ? employee.hireDate|date('Y-m-d H:i:s') : '-' }}</dd></div>

            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if employee.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: employee.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
            {% endif %}
        </dl>
    </div>
</div>
{% endblock %}
