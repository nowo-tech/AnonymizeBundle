{% extends 'base.html.twig' %}

{% block title %}Employees - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Employees', connection: connection, routePrefix: 'employee', currentPage: 'List'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    The following fields in this entity are configured for anonymization:
    <ul>
        <li><strong>firstName</strong> - Name faker</li>
        <li><strong>lastName</strong> - Surname faker</li>
        <li><strong>username</strong> - Username faker</li>
        <li><strong>email</strong> - Email faker</li>
        <li><strong>phone</strong> - Phone faker</li>
        <li><strong>birthDate</strong> - Date faker (past dates, age 18-65)</li>
        <li><strong>age</strong> - Age faker (numeric range: 22-65)</li>
        <li><strong>previousCompany</strong> - Company faker (LLC type)</li>
        <li><strong>hireDate</strong> - Date faker (past dates)</li>
    </ul>
    <strong class="mt-2 d-block">Note:</strong> This entity uses exclusion patterns (department='HR' will not be anonymized).
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Employees <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('employee_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Employee</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if employees|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Age</th>
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for employee in employees %}
                            <tr>
                                <td>{{ employee.id }}</td>
                                <td>{{ employee.firstName }} {{ employee.lastName }}</td>
                                <td>{{ employee.username }}</td>
                                <td>{{ employee.email }}</td>
                                <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ employee.department }}</span></td>
                                <td>{{ employee.age }}</td>
                                {% if hasAnonymizedColumn|default(false) %}
                                <td>
                                    {% if employee.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: employee.anonymized|default(false)} %}
                                {% endif %}
                                </td>
                                {% endif %}
                                <td>
                                    <div class="nowo-ui-row-actions">
                                        <a href="{{ path('employee_show', {connection: connection, id: employee.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                        <a href="{{ path('employee_edit', {connection: connection, id: employee.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                        {% set delete_form = demo_delete_form('employee_delete', {connection: connection, id: employee.id}, employee.id, 'Are you sure?') %}
                                        {{ form_start(delete_form) }}
                                        {{ form_end(delete_form) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No employees found. <a href="{{ path('employee_new', {connection: connection}) }}">Create the first one</a>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
