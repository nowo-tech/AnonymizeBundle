{% extends 'base.html.twig' %}

{% block title %}Employees - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('employee_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Employee</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Employees', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% if not hasAnonymizedColumn|default(false) %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Column "anonymized" not found', kind: 'detail'} %}
            {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">Warning</span>{% endblock %}
            {% block section_body %}
                <p>To add the anonymization tracking column, run:<br>
                <code class="nowo-ui-code">
                    php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
                </code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>The following fields in this entity are configured for anonymization:
            </p>
            <ul>
                    <li><strong>firstName</strong> - Name faker</li>
                    <li><strong>lastName</strong> - Surname faker</li>
                    <li><strong>username</strong> - Username faker</li>
                    <li><strong>email</strong> - Email faker</li>
                    <li><strong>phone</strong> - Phone faker</li>
                    <li><strong>birthDate</strong> - Date faker (past dates, age 18-65)</li>
                    <li><strong>age</strong> - Age faker (numeric range: 22-65)</li>
                    <li><strong>previousCompany</strong> - Company faker (LLC type)</li>
                    <li><strong>hireDate</strong> - Date faker (past dates)</li>
                </ul>
                <p class="nowo-ui-muted"><strong>Note:</strong> This entity uses exclusion patterns (department='HR' will not be anonymized).</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Employees', kind: 'table', empty: not (employees|length > 0), state_message: 'No employees found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Age</th>
                        {% if hasAnonymizedColumn|default(false) %}
                        <th>Anonymized</th>
                        {% endif %}
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for employee in employees %}
                        <tr>
                            <td>{{ employee.id }}</td>
                            <td>{{ employee.firstName }} {{ employee.lastName }}</td>
                            <td>{{ employee.username }}</td>
                            <td>{{ employee.email }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ employee.department }}</span></td>
                            <td>{{ employee.age }}</td>
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% if employee.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: employee.anonymized|default(false)} %}
                            {% endif %}
                            </td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('employee_show', {connection: connection, id: employee.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('employee_edit', {connection: connection, id: employee.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('employee_delete', {connection: connection, id: employee.id}, employee.id) %}

                                    {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (employee.id), message: 'Are you sure?', size: 'sm'} only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_empty_action %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('employee_new', {connection: connection}) }}">Create the first one</a>{% endblock %}
    {% endembed %}

{% endblock %}
