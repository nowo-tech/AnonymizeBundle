{% extends 'base.html.twig' %}

{% block title %}Temp Data Details - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Temp Data', connection: connection, routePrefix: 'temp_data', currentPage: 'Show'} %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Temp Data Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('temp_data_edit', {connection: connection, id: temp_data.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('temp_data_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ temp_data.id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Email</dt><dd class="nowo-ui-detail-list__value">{{ temp_data.email }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Name</dt><dd class="nowo-ui-detail-list__value">{{ temp_data.name }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Phone</dt><dd class="nowo-ui-detail-list__value">{{ temp_data.phone ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Created At</dt><dd class="nowo-ui-detail-list__value">{{ temp_data.createdAt ? temp_data.createdAt|date('Y-m-d H:i:s') : '-' }}</dd></div>

            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if temp_data.anonymized|default(false) %}
                {% include '_anonymized_badge.html.twig' with {value: temp_data.anonymized|default(false)} %}
                {% endif %}
            </dd></div>
            {% endif %}
        </dl>

        <div>
            {% set delete_form = demo_delete_form('temp_data_delete', {connection: connection, id: temp_data.id}, temp_data.id, 'Are you sure you want to delete this temp data?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Temp Data', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
