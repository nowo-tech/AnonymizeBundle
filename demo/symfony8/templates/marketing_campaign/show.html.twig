{% extends 'base.html.twig' %}

{% block title %}Marketing Campaign Details - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('marketing_campaign_edit', {connection: connection, id: marketingcampaign.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a> <a href="{{ path('marketing_campaign_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Marketing Campaign Details', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ marketingcampaign.id }}</dd></div>
                {% for field in marketingcampaign|keys %}
                    {% if field != 'id' and field != 'anonymized' %}
                    <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ field|replace({'_': ' '})|title }}</dt><dd class="nowo-ui-detail-list__value">{{ marketingcampaign[field] ?? '-' }}</dd></div>
                    {% endif %}
                {% endfor %}
                {% if hasAnonymizedColumn|default(false) %}
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                    {% if marketingcampaign.anonymized|default(false) %}
                    {% include '_anonymized_badge.html.twig' with {value: marketingcampaign.anonymized|default(false)} %}
                    {% endif %}
                </dd></div>
                {% endif %}
            </dl>
        {% endblock %}
        {% block section_footer %}
            {% set delete_form = demo_delete_form('marketing_campaign_delete', {connection: connection, id: marketingcampaign.id}, marketingcampaign.id) %}
            {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (marketingcampaign.id), message: 'Are you sure you want to delete this marketingcampaign?', label: 'Delete Marketing Campaign'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
