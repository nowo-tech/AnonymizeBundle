{% extends 'base.html.twig' %}

{% block title %}Marketing Campaign - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Marketing Campaign', connection: connection, routePrefix: 'marketing_campaign', currentPage: 'List'} %}

{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Marketing Campaign <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('marketing_campaign_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Marketing Campaign</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if marketingcampaign_list|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            {% for field in marketingcampaign_list[0]|keys %}
                                {% if field != 'id' and field != 'anonymized' %}
                                <th>{{ field|replace({'_': ' '})|title }}</th>
                                {% endif %}
                            {% endfor %}
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for marketingcampaign in marketingcampaign_list %}
                            <tr>
                                <td>{{ marketingcampaign.id ?? marketingcampaign.id }}</td>
                                {% for field in marketingcampaign_list[0]|keys %}
                                    {% if field != 'id' and field != 'anonymized' %}
                                    <td>{{ marketingcampaign[field] ?? '-' }}</td>
                                    {% endif %}
                                {% endfor %}
                                {% if hasAnonymizedColumn|default(false) %}
                                <td>
                                    {% if marketingcampaign.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: marketingcampaign.anonymized|default(false)} %}
                                    {% endif %}
                                </td>
                                {% endif %}
                                <td>
                                    <div class="nowo-ui-row-actions">
                                        <a href="{{ path('marketing_campaign_show', {connection: connection, id: marketingcampaign.id ?? marketingcampaign.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                        <a href="{{ path('marketing_campaign_edit', {connection: connection, id: marketingcampaign.id ?? marketingcampaign.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                        {% set delete_form = demo_delete_form('marketing_campaign_delete', {connection: connection, id: marketingcampaign.id ?? marketingcampaign.id}, (marketingcampaign.id ?? marketingcampaign.id), 'Are you sure?') %}
                                        {{ form_start(delete_form) }}
                                        {{ form_end(delete_form) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No marketingcampaign found. <a href="{{ path('marketing_campaign_new', {connection: connection}) }}">Create the first one</a>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
