{% extends 'base.html.twig' %}

{% block title %}Edit Marketing Campaign - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('marketing_campaign_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Edit Marketing Campaign', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Fields', kind: 'form', form: form} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-entity-form', class: 'nowo-ui-form', novalidate: true}}) }}
                {{ include('_form_fields.html.twig', {form: form}) }}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <a href="{{ path('marketing_campaign_show', {connection: connection, id: marketingcampaign.id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            {{ form_widget(form.save, {label: 'Update Marketing Campaign', attr: {form: 'demo-entity-form', class: 'nowo-ui-btn nowo-ui-btn--primary'}}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
