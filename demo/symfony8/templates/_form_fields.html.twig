{#
  Demo form body (REQ-TWIG-003): one child loop; UiKit's form theme lays the rows out. Labels, attr and help come from
  the FormType; the field order follows the FormType add() calls. The submit button (`save`) is rendered by the page,
  next to its Cancel link.
#}
{% for child in form %}
    {% if not child.rendered and child.vars.name != 'save' %}
        {{ form_row(child) }}
    {% endif %}
{% endfor %}
