{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's signed-in app shell (header, aside) and UiKit's
    default theme (nowo-ui.css from the bundle's own asset package, no CSS framework, no CDN, no token overrides). -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Anonymize Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_body %}
    {% set sidebarConnections = [
        { id: 'default', label: 'MySQL' },
        { id: 'postgres', label: 'PostgreSQL' }
    ] %}
    {% set sidebarMenu = [
        { section: 'Users', items: [ { name: 'Users', route: 'user_index' } ] },
        { section: 'Customers', items: [ { name: 'Customers', route: 'customer_index' } ] },
        { section: 'Products', items: [ { name: 'Products', route: 'product_index' } ] },
        { section: 'Orders', items: [ { name: 'Orders', route: 'order_index' } ] },
        { section: 'Invoices', items: [ { name: 'Invoices', route: 'invoice_index' } ] },
        { section: 'Employees', items: [ { name: 'Employees', route: 'employee_index' } ] },
        { section: 'Email Subscriptions', items: [ { name: 'Email Subscriptions', route: 'email_subscription_index' } ] },
        { section: 'System Logs', items: [ { name: 'System Logs', route: 'system_log_index' } ] },
        { section: 'Truncate Examples', items: [
            { name: 'Temp Data', route: 'temp_data_index' },
            { name: 'Cache Data', route: 'cache_data_index' },
            { name: 'Log Entries', route: 'log_entry_index' },
            { name: 'Notifications STI', route: 'notification_index' }
        ] },
        { section: 'Advanced Examples', items: [
            { name: 'Contacts', route: 'contact_index' },
            { name: 'Persons', route: 'person_index' },
            { name: 'Email Signatures', route: 'email_signature_index' },
            { name: 'User Accounts', route: 'user_account_index' },
            { name: 'Custom Faker Examples', route: 'custom_faker_example_index' },
            { name: 'Faker Type Examples', route: 'faker_type_example_index' },
            { name: 'Marketing Campaigns', route: 'marketing_campaign_index' }
        ] },
        { section: 'MongoDB', mongo: true, items: [
            { name: 'User Activities', route: 'mongodb_user_activity_index' },
            { name: 'Customer Profiles', route: 'mongodb_customer_profile_index' },
            { name: 'Transaction Logs', route: 'mongodb_transaction_log_index' },
            { name: 'Device Infos', route: 'mongodb_device_info_index' },
            { name: 'Analytics Events', route: 'mongodb_analytics_event_index' }
        ] }
    ] %}
    {% set _current = app.request.pathInfo %}
    {% set _brand %}
        <a class="nowo-ui-brand" href="{{ path('home') }}">Anonymize Bundle Demo - CRUD</a>
    {% endset %}
    {% set _header_end %}
        {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
    {% endset %}
    {% set _aside %}
        <div class="nowo-ui-aside__inner">
            <nav class="nowo-ui-aside__nav" aria-label="Demo navigation">
                <a class="nowo-ui-aside__link{{ _current == path('home') ? ' nowo-ui-aside__link--active' }}" href="{{ path('home') }}">Home</a>
                {% for group in sidebarMenu %}
                    <p class="nowo-ui-aside__label">{{ group.section }}</p>
                    {% if group.mongo is defined and group.mongo %}
                        {% for item in group.items %}
                            {% set _href = path(item.route) %}
                            <a class="nowo-ui-aside__link{{ _current starts with _href ? ' nowo-ui-aside__link--active' }}" href="{{ _href }}">{{ item.name }}</a>
                        {% endfor %}
                    {% else %}
                        {% for item in group.items %}
                            {% for conn in sidebarConnections %}
                                {% set _href = path(item.route, {connection: conn.id}) %}
                                <a class="nowo-ui-aside__link{{ _current starts with _href ? ' nowo-ui-aside__link--active' }}" href="{{ _href }}">{{ item.name }} ({{ conn.label }})</a>
                            {% endfor %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </nav>
        </div>
    {% endset %}

    {{ include(nowo_ui_partial('app_shell_open'), {brand_html: _brand, header_end: _header_end, aside_html: _aside, content_width: 'full'}) }}
        <div class="nowo-ui-content" id="nowo-ui-content">
            {% block nowo_ui_flashes %}
                {{ include(nowo_ui_partial('flashes'), {}) }}
            {% endblock %}
            {% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
        </div>
    {{ include(nowo_ui_partial('app_shell_close'), {}) }}
{% endblock %}
