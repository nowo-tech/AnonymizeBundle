{% extends 'base.html.twig' %}

{% block title %}Cache Data - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Cache Data', connection: connection, routePrefix: 'cache_data', currentPage: 'List'} %}

{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Truncate Feature</strong><br>
    This entity is configured with <code>truncate: true, truncate_order: 2</code>.
    The table will be emptied before anonymization runs (after TempData).
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Cache Data <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('cache_data_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Cache Data</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if cache_data_list|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cache Key</th>
                            <th>Cache Value</th>
                            <th>Expires At</th>
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for cache_data in cache_data_list %}
                            <tr>
                                <td>{{ cache_data.id ?? cache_data.id }}</td>
                                <td><code>{{ cache_data.cacheKey ?? '-' }}</code></td>
                                <td><pre class="nowo-ui-code-block">{{ (cache_data.cacheValue ?? [])|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></td>
                                <td>{{ cache_data.expiresAt ? cache_data.expiresAt|date('Y-m-d H:i:s') : '-' }}</td>
                                {% if hasAnonymizedColumn|default(false) %}
                                <td>
                                    {% if cache_data.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: cache_data.anonymized|default(false)} %}
                                    {% endif %}
                                </td>
                                {% endif %}
                                <td>
                                    <div class="nowo-ui-row-actions">
                                        <a href="{{ path('cache_data_show', {connection: connection, id: cache_data.id ?? cache_data.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                        <a href="{{ path('cache_data_edit', {connection: connection, id: cache_data.id ?? cache_data.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                        {% set delete_form = demo_delete_form('cache_data_delete', {connection: connection, id: cache_data.id ?? cache_data.id}, (cache_data.id ?? cache_data.id), 'Are you sure?') %}
                                        {{ form_start(delete_form) }}
                                        {{ form_end(delete_form) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No cache data found. <a href="{{ path('cache_data_new', {connection: connection}) }}">Create the first one</a>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
