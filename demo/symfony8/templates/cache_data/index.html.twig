{% extends 'base.html.twig' %}

{% block title %}Cache Data - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('cache_data_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Cache Data</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Cache Data', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% if not hasAnonymizedColumn|default(false) %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Column "anonymized" not found', kind: 'detail'} %}
            {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">Warning</span>{% endblock %}
            {% block section_body %}
                <p>To add the anonymization tracking column, run:<br>
                <code class="nowo-ui-code">
                    php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
                </code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Truncate Feature', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This entity is configured with <code class="nowo-ui-code">truncate: true, truncate_order: 2</code>.
            The table will be emptied before anonymization runs (after TempData).</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Cache Data', kind: 'table', empty: not (cache_data_list|length > 0), state_message: 'No cache data found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Cache Key</th>
                        <th>Cache Value</th>
                        <th>Expires At</th>
                        {% if hasAnonymizedColumn|default(false) %}
                        <th>Anonymized</th>
                        {% endif %}
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for cache_data in cache_data_list %}
                        <tr>
                            <td>{{ cache_data.id ?? cache_data.id }}</td>
                            <td><code class="nowo-ui-code">{{ cache_data.cacheKey ?? '-' }}</code></td>
                            <td><pre class="nowo-ui-code-block">{{ (cache_data.cacheValue ?? [])|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></td>
                            <td>{{ cache_data.expiresAt ? cache_data.expiresAt|date('Y-m-d H:i:s') : '-' }}</td>
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% if cache_data.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: cache_data.anonymized|default(false)} %}
                                {% endif %}
                            </td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('cache_data_show', {connection: connection, id: cache_data.id ?? cache_data.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('cache_data_edit', {connection: connection, id: cache_data.id ?? cache_data.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('cache_data_delete', {connection: connection, id: cache_data.id ?? cache_data.id}, (cache_data.id ?? cache_data.id)) %}

                                    {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ ((cache_data.id ?? cache_data.id)), message: 'Are you sure?', size: 'sm'} only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_empty_action %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('cache_data_new', {connection: connection}) }}">Create the first one</a>{% endblock %}
    {% endembed %}

{% endblock %}
