{% extends 'base.html.twig' %}

{% block title %}Cache Data Details - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('cache_data_edit', {connection: connection, id: cache_data.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a> <a href="{{ path('cache_data_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Cache Data Details', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ cache_data.id }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Cache Key</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ cache_data.cacheKey }}</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Cache Value</dt><dd class="nowo-ui-detail-list__value">
                    <pre class="nowo-ui-code-block">{{ cache_data.cacheValue|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                </dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Expires At</dt><dd class="nowo-ui-detail-list__value">{{ cache_data.expiresAt ? cache_data.expiresAt|date('Y-m-d H:i:s') : '-' }}</dd></div>
                {% if hasAnonymizedColumn|default(false) %}
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                    {% if cache_data.anonymized|default(false) %}
                    {% include '_anonymized_badge.html.twig' with {value: cache_data.anonymized|default(false)} %}
                    {% endif %}
                </dd></div>
                {% endif %}
            </dl>
        {% endblock %}
        {% block section_footer %}
            {% set delete_form = demo_delete_form('cache_data_delete', {connection: connection, id: cache_data.id}, cache_data.id) %}
            {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (cache_data.id), message: 'Are you sure you want to delete this cache data?', label: 'Delete Cache Data'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
