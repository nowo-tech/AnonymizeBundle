{% extends 'base.html.twig' %}

{% block title %}Notifications (Polymorphic STI) - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Notifications'}) }}
{% endblock %}

{% block body %}
    {% if not hasAnonymizedColumn|default(false) %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Column "anonymized" not found', kind: 'detail'} %}
            {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">Warning</span>{% endblock %}
            {% block section_body %}
                <p>To add the anonymization tracking column, run:<br>
                <code class="nowo-ui-code">
                    php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
                </code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Polymorphic truncate (STI)', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This table <code class="nowo-ui-code">notifications</code> uses Single Table Inheritance with discriminator <code class="nowo-ui-code">type</code> (email / sms).
            <code class="nowo-ui-code">EmailNotification</code> has <code class="nowo-ui-code">truncate: true, truncate_order: 1</code> and <code class="nowo-ui-code">SmsNotification</code> has <code class="nowo-ui-code">truncate: true, truncate_order: 2</code>.
            When you run anonymization, only rows of each type are deleted (DELETE WHERE type = 'email', then WHERE type = 'sms'), not the whole table at once.</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymization by service', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p><code class="nowo-ui-code">SmsNotification</code> uses <code class="nowo-ui-code">anonymizeService: SmsNotificationAnonymizerService::class</code>. Each SMS record is anonymized by that service (implementing the ORM-free <code class="nowo-ui-code">RowAnonymizerInterface</code>, since 1.6) instead of <code class="nowo-ui-code">AnonymizeProperty</code> attributes. <code class="nowo-ui-code">EmailNotification</code> keeps property-based anonymization.</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Notifications', kind: 'table', empty: not (notification_list|length > 0), state_message: 'No notifications found. With make setup (or doctrine:fixtures:load) notifications are loaded automatically. To load only now: php bin/console doctrine:fixtures:load --no-interaction --em={{ connection }}.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Recipient</th>
                        <th>Subject / Message</th>
                        <th>Created</th>
                        {% if hasAnonymizedColumn|default(false) %}
                        <th>Anonymized</th>
                        {% endif %}
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in notification_list %}
                        {% set n = row.item %}
                        {% set type = row.type %}
                        {% set id = n.id ?? n['id'] %}
                        {% set recipient = n.recipient ?? n['recipient'] ?? '-' %}
                        {% set subjectOrMessage = type == 'email' ? (n.subject ?? n['subject'] ?? '-') : (n.message ?? n['message'] ?? '-') %}
                        {% set created = n.createdAt ?? n['createdAt'] ?? n['created_at'] ?? null %}
                        <tr>
                            <td>{{ id }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--{{ type == 'email' ? 'primary' : 'neutral' }}">{{ type }}</span></td>
                            <td><code class="nowo-ui-code">{{ recipient }}</code></td>
                            <td>{{ subjectOrMessage }}</td>
                            <td>{{ created and not created is iterable ? (created.timestamp is defined ? created|date('Y-m-d H:i') : created) : '-' }}</td>
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% if n.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: n.anonymized|default(false)} %}
                                {% endif %}
                            </td>
                            {% endif %}
                            <td>
                                <a href="{{ path('notification_show', {connection: connection, id: id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

{% endblock %}
