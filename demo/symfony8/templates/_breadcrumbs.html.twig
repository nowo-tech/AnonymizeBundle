{# Breadcrumbs component (UiKit breadcrumb markup) #}
{# Usage: {% include '_breadcrumbs.html.twig' with {entityName: 'Users', connection: connection, currentPage: 'List'} %} #}
{# For MongoDB: {% include '_breadcrumbs.html.twig' with {entityName: 'User Activities', isMongo: true, currentPage: 'List'} %} #}

<nav aria-label="breadcrumb">
    <ol class="nowo-ui-breadcrumbs__list">
        <li class="nowo-ui-breadcrumbs__item">
            <a class="nowo-ui-breadcrumbs__link" href="{{ path('home') }}">Home</a>
            <span class="nowo-ui-breadcrumbs__separator" aria-hidden="true">/</span>
        </li>
        {# Ruta del listado. Notifications: literal notification_index. #}
        {% set _route = listRoute|default(indexRoute|default(routePrefix|default('') ~ '_index')) %}
        {% set _route = _route == 'notification_index_index' ? 'notification_index' : _route %}
        {% if entityName is defined and ('Notification' in entityName) %}
            {% set _route = 'notification_index' %}
        {% endif %}
        {% if isMongo|default(false) %}
            <li class="nowo-ui-breadcrumbs__item">
                <a class="nowo-ui-breadcrumbs__link" href="{{ path(_route) }}">{{ entityName }}</a>
                {% if currentPage is defined and currentPage != 'List' %}<span class="nowo-ui-breadcrumbs__separator" aria-hidden="true">/</span>{% endif %}
            </li>
        {% else %}
            <li class="nowo-ui-breadcrumbs__item">
                <a class="nowo-ui-breadcrumbs__link" href="{{ path(_route, {connection: connection}) }}">{{ entityName }} <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></a>
                {% if currentPage is defined and currentPage != 'List' %}<span class="nowo-ui-breadcrumbs__separator" aria-hidden="true">/</span>{% endif %}
            </li>
        {% endif %}
        {% if currentPage is defined and currentPage != 'List' %}
            <li class="nowo-ui-breadcrumbs__item" aria-current="page">{{ currentPage }}</li>
        {% endif %}
    </ol>
</nav>
