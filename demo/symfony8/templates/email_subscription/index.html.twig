{% extends 'base.html.twig' %}

{% block title %}Email Subscriptions - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Email Subscriptions', connection: connection, routePrefix: 'email_subscription', currentPage: 'List'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    The following fields in this entity are configured for anonymization:
    <ul>
        <li><strong>email</strong> - Email faker (pattern: %@test-domain.com|%@example.com|%@demo.local)</li>
        <li><strong>name</strong> - Name faker</li>
        <li><strong>backupEmail</strong> - Email faker (pattern: status inactive|unsubscribed)</li>
        <li><strong>subscribedAt</strong> - Date faker (past dates)</li>
        <li><strong>unsubscribedAt</strong> - Date faker (pattern: status unsubscribed)</li>
        <li><strong>notes</strong> - Text faker (pattern: status inactive|unsubscribed)</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Email Subscriptions <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('email_subscription_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if subscriptions|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Source</th>
                            <th>Subscribed At</th>
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for subscription in subscriptions %}
                        <tr>
                            <td>{{ subscription.id }}</td>
                            <td>{{ subscription.email }}</td>
                            <td>{{ subscription.name }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--{{ subscription.status == 'active' ? 'success' : (subscription.status == 'inactive' ? 'warning' : 'neutral') }}">{{ subscription.status }}</span></td>
                            <td>{{ subscription.source }}</td>
                            <td>{{ subscription.subscribedAt ? subscription.subscribedAt|date('Y-m-d H:i') : '' }}</td>
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% include '_anonymized_badge.html.twig' with {value: subscription.anonymized|default(false)} %}
                            </td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('email_subscription_show', {connection: connection, id: subscription.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('email_subscription_edit', {connection: connection, id: subscription.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('email_subscription_delete', {connection: connection, id: subscription.id}, subscription.id, 'Are you sure you want to delete this item?') %}
                                    {{ form_start(delete_form) }}
                                    {{ form_end(delete_form) }}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No email subscriptions found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
