{% extends 'base.html.twig' %}

{% block title %}Email Subscriptions - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('email_subscription_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Email Subscriptions', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% if not hasAnonymizedColumn|default(false) %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Column "anonymized" not found', kind: 'detail'} %}
            {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">Warning</span>{% endblock %}
            {% block section_body %}
                <p>To add the anonymization tracking column, run:<br>
                <code class="nowo-ui-code">
                    php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
                </code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>The following fields in this entity are configured for anonymization:
            </p>
            <ul>
                    <li><strong>email</strong> - Email faker (pattern: %@test-domain.com|%@example.com|%@demo.local)</li>
                    <li><strong>name</strong> - Name faker</li>
                    <li><strong>backupEmail</strong> - Email faker (pattern: status inactive|unsubscribed)</li>
                    <li><strong>subscribedAt</strong> - Date faker (past dates)</li>
                    <li><strong>unsubscribedAt</strong> - Date faker (pattern: status unsubscribed)</li>
                    <li><strong>notes</strong> - Text faker (pattern: status inactive|unsubscribed)</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Email Subscriptions', kind: 'table', empty: not (subscriptions|length > 0), state_message: 'No email subscriptions found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Source</th>
                        <th>Subscribed At</th>
                        {% if hasAnonymizedColumn|default(false) %}
                        <th>Anonymized</th>
                        {% endif %}
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for subscription in subscriptions %}
                    <tr>
                        <td>{{ subscription.id }}</td>
                        <td>{{ subscription.email }}</td>
                        <td>{{ subscription.name }}</td>
                        <td><span class="nowo-ui-badge nowo-ui-badge--{{ subscription.status == 'active' ? 'success' : (subscription.status == 'inactive' ? 'warning' : 'neutral') }}">{{ subscription.status }}</span></td>
                        <td>{{ subscription.source }}</td>
                        <td>{{ subscription.subscribedAt ? subscription.subscribedAt|date('Y-m-d H:i') : '' }}</td>
                        {% if hasAnonymizedColumn|default(false) %}
                        <td>
                            {% include '_anonymized_badge.html.twig' with {value: subscription.anonymized|default(false)} %}
                        </td>
                        {% endif %}
                        <td>
                            <div class="nowo-ui-row-actions">
                                <a href="{{ path('email_subscription_show', {connection: connection, id: subscription.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                <a href="{{ path('email_subscription_edit', {connection: connection, id: subscription.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                {% set delete_form = demo_delete_form('email_subscription_delete', {connection: connection, id: subscription.id}, subscription.id) %}

                                {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (subscription.id), message: 'Are you sure you want to delete this item?', size: 'sm'} only %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

{% endblock %}
