{% extends 'base.html.twig' %}

{% block title %}Email Subscription Details - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Email Subscriptions', connection: connection, routePrefix: 'email_subscription', currentPage: 'Show'} %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    The following fields in this entity are configured for anonymization:
    <ul>
        <li><strong>email</strong> - Email faker (pattern: %@test-domain.com|%@example.com|%@demo.local)</li>
        <li><strong>name</strong> - Name faker</li>
        <li><strong>backupEmail</strong> - Email faker (pattern: status inactive|unsubscribed)</li>
        <li><strong>subscribedAt</strong> - Date faker (past dates)</li>
        <li><strong>unsubscribedAt</strong> - Date faker (pattern: status unsubscribed)</li>
        <li><strong>notes</strong> - Text faker (pattern: status inactive|unsubscribed)</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Email Subscription Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('email_subscription_edit', {connection: connection, id: subscription.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('email_subscription_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ subscription.id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Email</dt><dd class="nowo-ui-detail-list__value">{{ subscription.email }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Name</dt><dd class="nowo-ui-detail-list__value">{{ subscription.name }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Status</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--{{ subscription.status == 'active' ? 'success' : (subscription.status == 'inactive' ? 'warning' : 'neutral') }}">{{ subscription.status }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Backup Email</dt><dd class="nowo-ui-detail-list__value">{{ subscription.backupEmail ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Source</dt><dd class="nowo-ui-detail-list__value">{{ subscription.source }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Subscribed At</dt><dd class="nowo-ui-detail-list__value">{{ subscription.subscribedAt ? subscription.subscribedAt|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Unsubscribed At</dt><dd class="nowo-ui-detail-list__value">{{ subscription.unsubscribedAt ? subscription.unsubscribedAt|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Notes</dt><dd class="nowo-ui-detail-list__value">{{ subscription.notes ?? '-' }}</dd></div>

            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if subscription.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: subscription.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
            {% endif %}
        </dl>

        <div>
            {% set delete_form = demo_delete_form('email_subscription_delete', {connection: connection, id: subscription.id}, subscription.id, 'Are you sure you want to delete this subscription?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Subscription', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
