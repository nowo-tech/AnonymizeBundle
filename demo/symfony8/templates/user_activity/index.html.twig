{% extends 'base.html.twig' %}

{% block title %}User Activities - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_user_activity_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Activity</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'User Activities', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>The following fields in this document are configured for anonymization:
            </p>
            <ul>
                    <li><strong>userEmail</strong> - Email faker</li>
                    <li><strong>userName</strong> - Name faker</li>
                    <li><strong>ipAddress</strong> - IP address faker</li>
                    <li><strong>timestamp</strong> - Date faker (past dates, range: -1 year to now)</li>
                    <li><strong>metadata</strong> - Name faker (for metadata fields)</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'User Activities', kind: 'table', empty: not (activities|length > 0), state: error|default(null) ? 'error' : null, state_message: error|default(null) ? error : 'No activities found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--success">MongoDB</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User Email</th>
                        <th>User Name</th>
                        <th>IP Address</th>
                        <th>Action</th>
                        <th>Timestamp</th>
                        <th>Anonymized</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for activity in activities %}
                        <tr>
                            <td>{{ activity._id }}</td>
                            <td>{{ activity.userEmail ?? '-' }}</td>
                            <td>{{ activity.userName ?? '-' }}</td>
                            <td>{{ activity.ipAddress ?? '-' }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--info">{{ activity.action ?? '-' }}</span></td>
                            <td>
                                {% if activity.timestamp %}
                                    {{ activity.timestamp.toDateTime()|date('Y-m-d H:i:s') }}
                                {% else %}
                                    -
                                {% endif %}
                            </td>
                            <td>
                                {% if activity.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: activity.anonymized|default(false)} %}
                            {% endif %}
                            </td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('mongodb_user_activity_show', {id: activity._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('mongodb_user_activity_edit', {id: activity._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('mongodb_user_activity_delete', {id: activity._id}, activity._id) %}

                                    {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (activity._id), message: 'Are you sure?', size: 'sm'} only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_empty_action %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('mongodb_user_activity_new') }}">Create the first one</a>{% endblock %}
    {% endembed %}

    {% if error is defined and error %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'To fix this', kind: 'detail'} %}
        {% block section_body %}
            <ul>
                                <li>Make sure MongoDB service is running: <code class="nowo-ui-code">docker-compose ps mongodb</code></li>
                                <li>Check MONGODB_URL environment variable is set in docker-compose.yml</li>
                                <li>Rebuild containers: <code class="nowo-ui-code">docker-compose build --no-cache php</code></li>
                                <li>Install dependencies: <code class="nowo-ui-code">docker-compose exec php composer install</code></li>
                            </ul>
        {% endblock %}
    {% endembed %}
    {% endif %}
{% endblock %}
