{% extends 'base.html.twig' %}

{% block title %}User Activity #{{ activity._id }} - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'User Activities', isMongo: true, routePrefix: 'mongodb_user_activity', currentPage: 'Show'} %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    The following fields in this document are configured for anonymization:
    <ul>
        <li><strong>userEmail</strong> - Email faker</li>
        <li><strong>userName</strong> - Name faker</li>
        <li><strong>ipAddress</strong> - IP address faker</li>
        <li><strong>timestamp</strong> - Date faker (past dates, range: -1 year to now)</li>
        <li><strong>metadata</strong> - Name faker (for metadata fields)</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">User Activity Details <span class="nowo-ui-badge nowo-ui-badge--success">MongoDB</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('mongodb_user_activity_edit', {id: activity._id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('mongodb_user_activity_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ activity._id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">User Email</dt><dd class="nowo-ui-detail-list__value">{{ activity.userEmail ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">User Name</dt><dd class="nowo-ui-detail-list__value">{{ activity.userName ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">IP Address</dt><dd class="nowo-ui-detail-list__value">{{ activity.ipAddress ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Action</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--info">{{ activity.action ?? '-' }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Timestamp</dt><dd class="nowo-ui-detail-list__value">
                {% if activity.timestamp %}
                    {{ activity.timestamp.toDateTime()|date('Y-m-d H:i:s') }}
                {% else %}
                    -
                {% endif %}
            </dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Metadata</dt><dd class="nowo-ui-detail-list__value">
                {% if activity.metadata %}
                    <pre class="nowo-ui-code-block"><code>{{ activity.metadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                {% else %}
                    -
                {% endif %}
            </dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if activity.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: activity.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
        </dl>
    </div>
</div>
{% endblock %}
