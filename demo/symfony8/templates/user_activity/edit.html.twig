{% extends 'base.html.twig' %}

{% block title %}Edit User Activity #{{ activity._id }} - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'User Activities', isMongo: true, routePrefix: 'mongodb_user_activity', currentPage: 'Edit'} %}
<p><a href="{{ path('mongodb_user_activity_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a></p>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Edit User Activity <span class="nowo-ui-badge nowo-ui-badge--success">MongoDB</span></h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form) }}
            {{ include('_form_fields.html.twig', {form: form}) }}

            <div class="nowo-ui-form__actions">
                {{ form_row(form.save, {label: 'Update Activity'}) }}
                <a href="{{ path('mongodb_user_activity_show', {id: activity._id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
