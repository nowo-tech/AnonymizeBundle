{% extends 'base.html.twig' %}

{% block title %}Edit User Activity #{{ activity._id }} - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_user_activity_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Edit User Activity', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Fields', kind: 'form', form: form} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--success">MongoDB</span>{% endblock %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-entity-form', class: 'nowo-ui-form', novalidate: true}}) }}
                {{ include('_form_fields.html.twig', {form: form}) }}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <a href="{{ path('mongodb_user_activity_show', {id: activity._id}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            {{ form_widget(form.save, {label: 'Update Activity', attr: {form: 'demo-entity-form', class: 'nowo-ui-btn nowo-ui-btn--primary'}}) }}
        {% endblock %}
    {% endembed %}
{% endblock %}
