{% extends 'base.html.twig' %}

{% block title %}System Logs - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'System Logs', connection: connection, routePrefix: 'system_log', currentPage: 'List'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This entity demonstrates all remaining faker types: uuid, ip_address, mac_address, password, hash, coordinate, color, boolean, numeric, file, json, text, enum, country, language, hash_preserve, shuffle, constant.
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">System Logs <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('system_log_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if logs|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Session ID</th>
                            <th>IP Address</th>
                            <th>Log Level</th>
                            <th>Country</th>
                            <th>Is Active</th>
                            <th>Created At</th>
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                        <tr>
                            <td>{{ log.id }}</td>
                            <td><code class="nowo-ui-code">{{ log.sessionId|slice(0, 8) }}...</code></td>
                            <td>{{ log.ipAddress }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--{{ log.logLevel == 'error' ? 'danger' : (log.logLevel == 'warning' ? 'warning' : 'info') }}">{{ log.logLevel }}</span></td>
                            <td>{{ log.countryCode }}</td>
                            <td>
                                {% if log.isActive %}
                                    <span class="nowo-ui-badge nowo-ui-badge--success">Yes</span>
                                {% else %}
                                    <span class="nowo-ui-badge nowo-ui-badge--neutral">No</span>
                                {% endif %}
                            </td>
                            <td>{{ log.createdAt ? log.createdAt|date('Y-m-d H:i') : '' }}</td>
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% include '_anonymized_badge.html.twig' with {value: log.anonymized|default(false)} %}
                            </td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('system_log_show', {connection: connection, id: log.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('system_log_edit', {connection: connection, id: log.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('system_log_delete', {connection: connection, id: log.id}, log.id, 'Are you sure you want to delete this item?') %}
                                    {{ form_start(delete_form) }}
                                    {{ form_end(delete_form) }}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No system logs found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
