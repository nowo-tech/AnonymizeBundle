{% extends 'base.html.twig' %}

{% block title %}System Log Details - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'System Logs', connection: connection, routePrefix: 'system_log', currentPage: 'Show'} %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This entity demonstrates all remaining faker types: uuid, ip_address, mac_address, password, hash, coordinate, color, boolean, numeric, file, json, text, enum, country, language, hash_preserve, shuffle, constant.
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">System Log Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('system_log_edit', {connection: connection, id: log.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('system_log_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ log.id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Session ID</dt><dd class="nowo-ui-detail-list__value"><code>{{ log.sessionId }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">IP Address</dt><dd class="nowo-ui-detail-list__value">{{ log.ipAddress }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">MAC Address</dt><dd class="nowo-ui-detail-list__value"><code>{{ log.macAddress }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">API Key</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ log.apiKey|slice(0, 20) }}...</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Token Hash</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ log.tokenHash }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Location</dt><dd class="nowo-ui-detail-list__value">{{ log.location }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Theme Color</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral" style="background-color: {{ log.themeColor }}">{{ log.themeColor }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Is Active</dt><dd class="nowo-ui-detail-list__value">
                {% if log.isActive %}
                    <span class="nowo-ui-badge nowo-ui-badge--success">Yes</span>
                {% else %}
                    <span class="nowo-ui-badge nowo-ui-badge--neutral">No</span>
                {% endif %}
            </dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Score</dt><dd class="nowo-ui-detail-list__value">{{ log.score }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Log File</dt><dd class="nowo-ui-detail-list__value"><code>{{ log.logFile }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Metadata</dt><dd class="nowo-ui-detail-list__value"><pre class="small">{{ log.metadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Description</dt><dd class="nowo-ui-detail-list__value">{{ log.description ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Log Level</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--{{ log.logLevel == 'error' ? 'danger' : (log.logLevel == 'warning' ? 'warning' : 'info') }}">{{ log.logLevel }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Country Code</dt><dd class="nowo-ui-detail-list__value">{{ log.countryCode }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Language Code</dt><dd class="nowo-ui-detail-list__value">{{ log.languageCode }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Created At</dt><dd class="nowo-ui-detail-list__value">{{ log.createdAt ? log.createdAt|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">User ID Hash</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ log.userIdHash }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Process Status</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--info">{{ log.processStatus ?? '-' }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Data Classification</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--warning">{{ log.dataClassification ?? '-' }}</span></dd></div>

            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if log.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: log.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
            {% endif %}
        </dl>

        <div>
            {% set delete_form = demo_delete_form('system_log_delete', {connection: connection, id: log.id}, log.id, 'Are you sure you want to delete this log?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Log', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
