{% extends 'base.html.twig' %}

{% block title %}Log Entry Details - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('log_entry_edit', {connection: connection, id: log_entry.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a> <a href="{{ path('log_entry_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Log Entry Details', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ log_entry.id }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Message</dt><dd class="nowo-ui-detail-list__value">{{ log_entry.message }}</dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">IP Address</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ log_entry.ipAddress }}</code></dd></div>
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Logged At</dt><dd class="nowo-ui-detail-list__value">{{ log_entry.loggedAt ? log_entry.loggedAt|date('Y-m-d H:i:s') : '-' }}</dd></div>
                {% if hasAnonymizedColumn|default(false) %}
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                    {% if log_entry.anonymized|default(false) %}
                    {% include '_anonymized_badge.html.twig' with {value: log_entry.anonymized|default(false)} %}
                    {% endif %}
                </dd></div>
                {% endif %}
            </dl>
        {% endblock %}
        {% block section_footer %}
            {% set delete_form = demo_delete_form('log_entry_delete', {connection: connection, id: log_entry.id}, log_entry.id) %}
            {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (log_entry.id), message: 'Are you sure you want to delete this log entry?', label: 'Delete Log Entry'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
