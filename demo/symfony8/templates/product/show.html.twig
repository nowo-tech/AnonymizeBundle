{% extends 'base.html.twig' %}

{% block title %}Product #{{ product.id }} - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Products', connection: connection, routePrefix: 'product', currentPage: 'Show'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Product Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('product_edit', {connection: connection, id: product.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('product_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ product.id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Name</dt><dd class="nowo-ui-detail-list__value">{{ product.name }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Description</dt><dd class="nowo-ui-detail-list__value">{{ product.description ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Price</dt><dd class="nowo-ui-detail-list__value">${{ product.price }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Image URL</dt><dd class="nowo-ui-detail-list__value">
                {% if product.imageUrl %}
                    <a href="{{ product.imageUrl }}" target="_blank" rel="noopener noreferrer">{{ product.imageUrl }}</a>
                {% else %}
                    -
                {% endif %}
            </dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Status</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ product.status }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Created At</dt><dd class="nowo-ui-detail-list__value">{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '-' }}</dd></div>

            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if product.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: product.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
            {% endif %}
        </dl>
    </div>
</div>
{% endblock %}
