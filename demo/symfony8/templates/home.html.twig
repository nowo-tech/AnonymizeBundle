{% extends 'base.html.twig' %}

{% block title %}Home - Anonymize Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Welcome to the Anonymize Bundle Demo', intro: 'This demo shows how to use the AnonymizeBundle with multiple database connections.'}) }}
{% endblock %}

{% block body %}
    {% set connectionList = [
    { id: 'default', label: 'MySQL' },
    { id: 'postgres', label: 'PostgreSQL' }
] %}

{% set crudSections = [
    {
        title: null,
        items: [
            { name: 'Users', route: 'user_index' },
            { name: 'Customers', route: 'customer_index' },
            { name: 'Products', route: 'product_index' },
            { name: 'Orders', route: 'order_index' },
            { name: 'Invoices', route: 'invoice_index' },
            { name: 'Employees', route: 'employee_index' },
            { name: 'Email Subscriptions', route: 'email_subscription_index' },
            { name: 'System Logs', route: 'system_log_index' },
            { name: 'Temp Data', route: 'temp_data_index', badge: { text: 'Truncate Order: 1', class: 'info' } },
            { name: 'Cache Data', route: 'cache_data_index', badge: { text: 'Truncate Order: 2', class: 'info' } },
            { name: 'Log Entries', route: 'log_entry_index', badge: { text: 'Truncate Order: null', class: 'neutral' } },
            { name: 'Notifications', route: 'notification_index', badge: { text: 'Polymorphic STI', class: 'warning' }, hint: 'Single table inheritance: truncate deletes by discriminator (email / sms).' }
        ]
    },
    {
        title: 'Advanced Examples',
        items: [
            { name: 'Contacts', route: 'contact_index' },
            { name: 'Persons', route: 'person_index' },
            { name: 'Email Signatures', route: 'email_signature_index' },
            { name: 'User Accounts', route: 'user_account_index' },
            { name: 'Custom Faker Examples', route: 'custom_faker_example_index' },
            { name: 'Faker Type Examples', route: 'faker_type_example_index' },
            { name: 'Marketing Campaigns', route: 'marketing_campaign_index' }
        ]
    }
] %}

{% set mongoItems = [
    { name: 'User Activities', route: 'mongodb_user_activity_index' },
    { name: 'Customer Profiles', route: 'mongodb_customer_profile_index' },
    { name: 'Transaction Logs', route: 'mongodb_transaction_log_index' },
    { name: 'Device Infos', route: 'mongodb_device_info_index' },
    { name: 'Analytics Events', route: 'mongodb_analytics_event_index' }
] %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Available connections', kind: 'list'} %}
    {% block section_body %}
        <ul>
            <li><strong>default</strong> - MySQL 8.0 (Docker service <code class="nowo-ui-code">mysql</code>)</li>
            <li><strong>postgres</strong> - PostgreSQL 16 (Docker service <code class="nowo-ui-code">postgres</code>)</li>
            <li><strong>mongodb</strong> - MongoDB 7.0 (optional host port 27018)</li>
        </ul>
    {% endblock %}
{% endembed %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Database interfaces', kind: 'list'} %}
    {% block section_body %}
        <ul>
            <li><a class="nowo-ui-link" href="http://localhost:8084" target="_blank" rel="noopener">phpMyAdmin (MySQL)</a></li>
            <li><a class="nowo-ui-link" href="http://localhost:8085" target="_blank" rel="noopener">pgAdmin (PostgreSQL)</a></li>
            <li><a class="nowo-ui-link" href="http://localhost:8086" target="_blank" rel="noopener">Mongo Express (MongoDB)</a></li>
        </ul>
    {% endblock %}
{% endembed %}

{% for section in crudSections %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: section.title ?? 'CRUD by connection', intro: section.title ? null : 'You can manage entities in each connection.', kind: 'table', section: section, connectionList: connectionList} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th scope="col">Entity</th>
                        {% for conn in connectionList %}<th scope="col">{{ conn.label }}</th>{% endfor %}
                        <th scope="col" class="nowo-ui-cell--wrap">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in section.items %}
                        <tr>
                            <th scope="row">{{ item.name }}</th>
                            {% for conn in connectionList %}
                                <td><a class="nowo-ui-link" href="{{ path(item.route, {connection: conn.id}) }}">{{ item.name }} in {{ conn.label }}</a></td>
                            {% endfor %}
                            <td class="nowo-ui-cell--wrap">
                                {% if item.badge is defined %}<span class="nowo-ui-badge nowo-ui-badge--{{ item.badge.class }}">{{ item.badge.text }}</span>{% endif %}
                                {% if item.hint is defined %}{{ item.hint }}{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}
{% endfor %}

{% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'MongoDB collections', kind: 'list', mongoItems: mongoItems} %}
    {% block section_body %}
        <ul>
            {% for item in mongoItems %}
                <li><a class="nowo-ui-link" href="{{ path(item.route) }}">{{ item.name }}</a></li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endembed %}
{% endblock %}
