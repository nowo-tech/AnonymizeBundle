{% extends 'base.html.twig' %}

{% block title %}Email Signature Details - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Email Signature', connection: connection, routePrefix: 'email_signature', currentPage: 'Show'} %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Email Signature Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('email_signature_edit', {connection: connection, id: emailsignature.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('email_signature_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ emailsignature.id }}</dd></div>
            {% for field in emailsignature|keys %}
                {% if field != 'id' and field != 'anonymized' %}
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ field|replace({'_': ' '})|title }}</dt><dd class="nowo-ui-detail-list__value">{{ emailsignature[field] ?? '-' }}</dd></div>
                {% endif %}
            {% endfor %}
            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if emailsignature.anonymized|default(false) %}
                {% include '_anonymized_badge.html.twig' with {value: emailsignature.anonymized|default(false)} %}
                {% endif %}
            </dd></div>
            {% endif %}
        </dl>

        <div>
            {% set delete_form = demo_delete_form('email_signature_delete', {connection: connection, id: emailsignature.id}, emailsignature.id, 'Are you sure you want to delete this emailsignature?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Email Signature', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
