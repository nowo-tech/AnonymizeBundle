{% extends 'base.html.twig' %}

{% block title %}Order #{{ order.id }} - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Orders', connection: connection, routePrefix: 'order', currentPage: 'Show'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Order Details <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('order_edit', {connection: connection, id: order.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('order_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ order.id }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Order Number</dt><dd class="nowo-ui-detail-list__value">{{ order.orderNumber ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Shipping Address</dt><dd class="nowo-ui-detail-list__value">{{ order.shippingAddress }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Billing Address</dt><dd class="nowo-ui-detail-list__value">{{ order.billingAddress ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Total Amount</dt><dd class="nowo-ui-detail-list__value">${{ order.totalAmount }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Order Date</dt><dd class="nowo-ui-detail-list__value">{{ order.orderDate ? order.orderDate|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Status</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ order.status }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Customer Email</dt><dd class="nowo-ui-detail-list__value">{{ order.customerEmail ?? '-' }}</dd></div>

            {% if order.type %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Type</dt><dd class="nowo-ui-detail-list__value">{{ order.type.name ?? '-' }}</dd></div>
            {% endif %}

            {% if hasAnonymizedColumn|default(false) %}
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if order.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: order.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
            {% endif %}
        </dl>
    </div>
</div>
{% endblock %}
