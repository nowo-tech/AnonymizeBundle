{% extends 'base.html.twig' %}

{% block title %}New Order - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Orders', connection: connection, routePrefix: 'order', currentPage: 'New'} %}
<p><a href="{{ path('order_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">← Back to List</a></p>
<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Create New Order <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
    </div>
    <div class="nowo-ui-card__body">
        {{ form_start(form, {'attr': {'novalidate': true}}) }}
            {{ include('_form_fields.html.twig', {form: form}) }}

            <div class="nowo-ui-form__actions">
                {{ form_row(form.save, {label: 'Create Order'}) }}
                <a href="{{ path('order_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Cancel</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
