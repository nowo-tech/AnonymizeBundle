{% extends 'base.html.twig' %}

{% block title %}Analytics Events - MongoDB{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('mongodb_analytics_event_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Analytics Events', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>This MongoDB document demonstrates structured data fakers:
            </p>
            <ul>
                    <li><strong>eventId</strong> - UUID faker</li>
                    <li><strong>eventType</strong> - Enum faker</li>
                    <li><strong>country</strong> - Country faker</li>
                    <li><strong>language</strong> - Language faker</li>
                    <li><strong>eventData</strong> - JSON faker</li>
                    <li><strong>description</strong> - Text faker</li>
                    <li><strong>userIdHash</strong> - Hash preserve faker</li>
                    <li><strong>category</strong> - Shuffle faker</li>
                    <li><strong>dataClassification</strong> - Constant faker</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Analytics Events', kind: 'table', empty: not (events|length > 0), state_message: 'No analytics events found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Event ID</th>
                        <th>Event Type</th>
                        <th>Country</th>
                        <th>Language</th>
                        <th>Category</th>
                        <th>Timestamp</th>
                        <th>Anonymized</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                    <tr>
                        <td><code class="nowo-ui-code">{{ event._id|slice(0, 8) }}...</code></td>
                        <td><code class="nowo-ui-code">{{ event.eventId|slice(0, 8) }}...</code></td>
                        <td><span class="nowo-ui-badge nowo-ui-badge--{{ event.eventType == 'purchase' ? 'success' : (event.eventType == 'click' ? 'info' : 'primary') }}">{{ event.eventType }}</span></td>
                        <td>{{ event.country }}</td>
                        <td>{{ event.language }}</td>
                        <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ event.category ?? '-' }}</span></td>
                        <td>{{ event.timestamp ? event.timestamp.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                        <td>
                            {% if event.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: event.anonymized|default(false)} %}
                            {% endif %}
                        </td>
                        <td>
                            <div class="nowo-ui-row-actions">
                                <a href="{{ path('mongodb_analytics_event_show', {id: event._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                <a href="{{ path('mongodb_analytics_event_edit', {id: event._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                {% set delete_form = demo_delete_form('mongodb_analytics_event_delete', {id: event._id}, event._id) %}

                                {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (event._id), message: 'Are you sure you want to delete this item?', size: 'sm'} only %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

{% endblock %}
