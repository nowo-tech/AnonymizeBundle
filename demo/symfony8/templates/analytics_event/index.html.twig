{% extends 'base.html.twig' %}

{% block title %}Analytics Events - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Analytics Events', isMongo: true, routePrefix: 'mongodb_analytics_event', currentPage: 'List'} %}
{% if error|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--error" role="alert">
    <strong>⚠️ Error:</strong> {{ error }}
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This MongoDB document demonstrates structured data fakers:
    <ul>
        <li><strong>eventId</strong> - UUID faker</li>
        <li><strong>eventType</strong> - Enum faker</li>
        <li><strong>country</strong> - Country faker</li>
        <li><strong>language</strong> - Language faker</li>
        <li><strong>eventData</strong> - JSON faker</li>
        <li><strong>description</strong> - Text faker</li>
        <li><strong>userIdHash</strong> - Hash preserve faker</li>
        <li><strong>category</strong> - Shuffle faker</li>
        <li><strong>dataClassification</strong> - Constant faker</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Analytics Events <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
        <a href="{{ path('mongodb_analytics_event_new') }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if events|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Event ID</th>
                            <th>Event Type</th>
                            <th>Country</th>
                            <th>Language</th>
                            <th>Category</th>
                            <th>Timestamp</th>
                            <th>Anonymized</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                        <tr>
                            <td><code class="nowo-ui-code">{{ event._id|slice(0, 8) }}...</code></td>
                            <td><code class="nowo-ui-code">{{ event.eventId|slice(0, 8) }}...</code></td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--{{ event.eventType == 'purchase' ? 'success' : (event.eventType == 'click' ? 'info' : 'primary') }}">{{ event.eventType }}</span></td>
                            <td>{{ event.country }}</td>
                            <td>{{ event.language }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ event.category ?? '-' }}</span></td>
                            <td>{{ event.timestamp ? event.timestamp.toDateTime()|date('Y-m-d H:i') : '-' }}</td>
                            <td>
                                {% if event.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: event.anonymized|default(false)} %}
                                {% endif %}
                            </td>
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('mongodb_analytics_event_show', {id: event._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('mongodb_analytics_event_edit', {id: event._id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('mongodb_analytics_event_delete', {id: event._id}, event._id, 'Are you sure you want to delete this item?') %}
                                    {{ form_start(delete_form) }}
                                    {{ form_end(delete_form) }}
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No analytics events found.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
