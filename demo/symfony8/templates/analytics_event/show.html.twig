{% extends 'base.html.twig' %}

{% block title %}Analytics Event Details - MongoDB{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Analytics Events', isMongo: true, routePrefix: 'mongodb_analytics_event', currentPage: 'Show'} %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    This MongoDB document demonstrates structured data fakers: json, text, enum, country, language, hash_preserve, shuffle, constant.
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Analytics Event Details <span class="nowo-ui-badge nowo-ui-badge--info">MongoDB</span></h2>
        <div class="nowo-ui-row-actions">
            <a href="{{ path('mongodb_analytics_event_edit', {id: event._id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a>
            <a href="{{ path('mongodb_analytics_event_index') }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>
        </div>
    </div>
    <div class="nowo-ui-card__body">
        <dl class="nowo-ui-detail-list">
            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value"><code>{{ event._id }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Event ID (UUID)</dt><dd class="nowo-ui-detail-list__value"><code>{{ event.eventId }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Event Type</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--{{ event.eventType == 'purchase' ? 'success' : (event.eventType == 'click' ? 'info' : 'primary') }}">{{ event.eventType }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Country</dt><dd class="nowo-ui-detail-list__value">{{ event.country }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Language</dt><dd class="nowo-ui-detail-list__value">{{ event.language }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Event Data (JSON)</dt><dd class="nowo-ui-detail-list__value"><pre class="small">{{ event.eventData|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Description</dt><dd class="nowo-ui-detail-list__value">{{ event.description ?? '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">User ID Hash</dt><dd class="nowo-ui-detail-list__value"><code class="nowo-ui-code">{{ event.userIdHash ?? '-' }}</code></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Category</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ event.category ?? '-' }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Data Classification</dt><dd class="nowo-ui-detail-list__value"><span class="nowo-ui-badge nowo-ui-badge--warning">{{ event.dataClassification ?? '-' }}</span></dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Timestamp</dt><dd class="nowo-ui-detail-list__value">{{ event.timestamp ? event.timestamp.toDateTime()|date('Y-m-d H:i:s') : '-' }}</dd></div>

            <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                {% if event.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: event.anonymized|default(false)} %}
                                {% endif %}
            </dd></div>
        </dl>

        <div>
            {% set delete_form = demo_delete_form('mongodb_analytics_event_delete', {id: event._id}, event._id, 'Are you sure you want to delete this event?') %}
            {{ form_start(delete_form) }}
                {{ form_row(delete_form.delete, {label: 'Delete Event', attr: {class: 'nowo-ui-btn nowo-ui-btn--danger'}}) }}
            {{ form_end(delete_form) }}
        </div>
    </div>
</div>
{% endblock %}
