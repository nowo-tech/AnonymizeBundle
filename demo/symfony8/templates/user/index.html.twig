{% extends 'base.html.twig' %}

{% block title %}Users - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('user_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New User</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Users', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% if not hasAnonymizedColumn|default(false) %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Column "anonymized" not found', kind: 'detail'} %}
            {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">Warning</span>{% endblock %}
            {% block section_body %}
                <p>To add the anonymization tracking column, run:<br>
                <code class="nowo-ui-code">
                    php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
                </code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Anonymized Fields', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--info">Info</span>{% endblock %}
        {% block section_body %}
            <p>The following fields in this entity are configured for anonymization:
            </p>
            <ul>
                    <li><strong>email</strong> - Email faker</li>
                    <li><strong>firstName</strong> - Name faker</li>
                    <li><strong>lastName</strong> - Surname faker</li>
                    <li><strong>age</strong> - Age faker (numeric range: 18-100)</li>
                    <li><strong>phone</strong> - Phone faker</li>
                    <li><strong>iban</strong> - IBAN faker (ES country)</li>
                    <li><strong>creditCard</strong> - Credit card faker</li>
                </ul>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Users', kind: 'table', empty: not (users|length > 0), state_message: 'No users found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Email</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Age</th>
                        <th>Phone</th>
                        <th>Status</th>
                        {% if hasAnonymizedColumn|default(false) %}
                        <th>Anonymized</th>
                        {% endif %}
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.firstName }}</td>
                            <td>{{ user.lastName }}</td>
                            <td>{{ user.age }}</td>
                            <td>{{ user.phone ?? '-' }}</td>
                            <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ user.status }}</span></td>
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% if user.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: user.anonymized|default(false)} %}
                            {% endif %}
                            </td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('user_show', {connection: connection, id: user.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('user_edit', {connection: connection, id: user.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('user_delete', {connection: connection, id: user.id}, user.id) %}

                                    {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (user.id), message: 'Are you sure?', size: 'sm'} only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_empty_action %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('user_new', {connection: connection}) }}">Create the first one</a>{% endblock %}
    {% endembed %}

{% endblock %}
