{# Standardized anonymized badge component #}
{# Usage: {% include '_anonymized_badge.html.twig' with {value: entity.anonymized|default(false)} %} #}

{% if value %}
    <span class="nowo-ui-badge nowo-ui-badge--success">Anonymized</span>
{% else %}
    <span class="nowo-ui-badge nowo-ui-badge--neutral">Not Anonymized</span>
{% endif %}
