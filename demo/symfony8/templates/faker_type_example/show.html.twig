{% extends 'base.html.twig' %}

{% block title %}Faker Type Example Details - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('faker_type_example_edit', {connection: connection, id: fakertypeexample.id}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Edit</a> <a href="{{ path('faker_type_example_index', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--outline">Back to List</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Faker Type Example Details', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Details', kind: 'detail'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">ID</dt><dd class="nowo-ui-detail-list__value">{{ fakertypeexample.id }}</dd></div>
                {% for field in fakertypeexample|keys %}
                    {% if field != 'id' and field != 'anonymized' %}
                    <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ field|replace({'_': ' '})|title }}</dt><dd class="nowo-ui-detail-list__value">{{ fakertypeexample[field] ?? '-' }}</dd></div>
                    {% endif %}
                {% endfor %}
                {% if hasAnonymizedColumn|default(false) %}
                <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">Anonymized</dt><dd class="nowo-ui-detail-list__value">
                    {% if fakertypeexample.anonymized|default(false) %}
                    {% include '_anonymized_badge.html.twig' with {value: fakertypeexample.anonymized|default(false)} %}
                    {% endif %}
                </dd></div>
                {% endif %}
            </dl>
        {% endblock %}
        {% block section_footer %}
            {% set delete_form = demo_delete_form('faker_type_example_delete', {connection: connection, id: fakertypeexample.id}, fakertypeexample.id) %}
            {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ (fakertypeexample.id), message: 'Are you sure you want to delete this fakertypeexample?', label: 'Delete Faker Type Example'} only %}
        {% endblock %}
    {% endembed %}
{% endblock %}
