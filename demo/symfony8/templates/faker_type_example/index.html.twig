{% extends 'base.html.twig' %}

{% block title %}Faker Type Example - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Faker Type Example', connection: connection, routePrefix: 'faker_type_example', currentPage: 'List'} %}

{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Faker Type Example <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('faker_type_example_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Faker Type Example</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if fakertypeexample_list|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            {% for field in fakertypeexample_list[0]|keys %}
                                {% if field != 'id' and field != 'anonymized' %}
                                <th>{{ field|replace({'_': ' '})|title }}</th>
                                {% endif %}
                            {% endfor %}
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for fakertypeexample in fakertypeexample_list %}
                            <tr>
                                <td>{{ fakertypeexample.id ?? fakertypeexample.id }}</td>
                                {% for field in fakertypeexample_list[0]|keys %}
                                    {% if field != 'id' and field != 'anonymized' %}
                                    <td>{{ fakertypeexample[field] ?? '-' }}</td>
                                    {% endif %}
                                {% endfor %}
                                {% if hasAnonymizedColumn|default(false) %}
                                <td>
                                    {% if fakertypeexample.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: fakertypeexample.anonymized|default(false)} %}
                                    {% endif %}
                                </td>
                                {% endif %}
                                <td>
                                    <div class="nowo-ui-row-actions">
                                        <a href="{{ path('faker_type_example_show', {connection: connection, id: fakertypeexample.id ?? fakertypeexample.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                        <a href="{{ path('faker_type_example_edit', {connection: connection, id: fakertypeexample.id ?? fakertypeexample.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                        {% set delete_form = demo_delete_form('faker_type_example_delete', {connection: connection, id: fakertypeexample.id ?? fakertypeexample.id}, (fakertypeexample.id ?? fakertypeexample.id), 'Are you sure?') %}
                                        {{ form_start(delete_form) }}
                                        {{ form_end(delete_form) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No fakertypeexample found. <a href="{{ path('faker_type_example_new', {connection: connection}) }}">Create the first one</a>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
