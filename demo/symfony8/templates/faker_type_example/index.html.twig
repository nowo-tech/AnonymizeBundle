{% extends 'base.html.twig' %}

{% block title %}Faker Type Example - {{ connection|upper }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a href="{{ path('faker_type_example_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Faker Type Example</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {title: 'Faker Type Example', toolbar: _toolbar}) }}
{% endblock %}

{% block body %}
    {% if not hasAnonymizedColumn|default(false) %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Column "anonymized" not found', kind: 'detail'} %}
            {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--warning">Warning</span>{% endblock %}
            {% block section_body %}
                <p>To add the anonymization tracking column, run:<br>
                <code class="nowo-ui-code">
                    php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
                </code></p>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Faker Type Example', kind: 'table', empty: not (fakertypeexample_list|length > 0), state_message: 'No fakertypeexample found.'} %}
        {% block section_actions %}<span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span>{% endblock %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        {% for field in fakertypeexample_list[0]|keys %}
                            {% if field != 'id' and field != 'anonymized' %}
                            <th>{{ field|replace({'_': ' '})|title }}</th>
                            {% endif %}
                        {% endfor %}
                        {% if hasAnonymizedColumn|default(false) %}
                        <th>Anonymized</th>
                        {% endif %}
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for fakertypeexample in fakertypeexample_list %}
                        <tr>
                            <td>{{ fakertypeexample.id ?? fakertypeexample.id }}</td>
                            {% for field in fakertypeexample_list[0]|keys %}
                                {% if field != 'id' and field != 'anonymized' %}
                                <td>{{ fakertypeexample[field] ?? '-' }}</td>
                                {% endif %}
                            {% endfor %}
                            {% if hasAnonymizedColumn|default(false) %}
                            <td>
                                {% if fakertypeexample.anonymized|default(false) %}
                                {% include '_anonymized_badge.html.twig' with {value: fakertypeexample.anonymized|default(false)} %}
                                {% endif %}
                            </td>
                            {% endif %}
                            <td>
                                <div class="nowo-ui-row-actions">
                                    <a href="{{ path('faker_type_example_show', {connection: connection, id: fakertypeexample.id ?? fakertypeexample.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                    <a href="{{ path('faker_type_example_edit', {connection: connection, id: fakertypeexample.id ?? fakertypeexample.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                    {% set delete_form = demo_delete_form('faker_type_example_delete', {connection: connection, id: fakertypeexample.id ?? fakertypeexample.id}, (fakertypeexample.id ?? fakertypeexample.id)) %}

                                    {% include '_delete.html.twig' with {form: delete_form, dialog_id: 'delete-' ~ ((fakertypeexample.id ?? fakertypeexample.id)), message: 'Are you sure?', size: 'sm'} only %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
        {% block section_empty_action %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('faker_type_example_new', {connection: connection}) }}">Create the first one</a>{% endblock %}
    {% endembed %}

{% endblock %}
