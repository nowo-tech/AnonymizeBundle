{% extends 'base.html.twig' %}

{% block title %}Customers - {{ connection|upper }}{% endblock %}

{% block body %}
{% include '_breadcrumbs.html.twig' with {entityName: 'Customers', connection: connection, routePrefix: 'customer', currentPage: 'List'} %}
{% if not hasAnonymizedColumn|default(false) %}
<div class="nowo-ui-flash nowo-ui-flash--warning" role="note">
    <strong>⚠️ Column "anonymized" not found</strong><br>
    To add the anonymization tracking column, run:<br>
    <code class="nowo-ui-code">
        php bin/console nowo:anonymize:generate-column-migration --connection {{ connection }}
    </code>
</div>
{% endif %}

<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    <strong>ℹ️ Anonymized Fields</strong><br>
    The following fields in this entity are configured for anonymization:
    <ul>
        <li><strong>email</strong> - Email faker</li>
        <li><strong>name</strong> - Name faker</li>
        <li><strong>referenceCode</strong> - Custom service faker</li>
    </ul>
</div>

<div class="nowo-ui-card">
    <div class="nowo-ui-card__header">
        <h2 class="nowo-ui-card__title">Customers <span class="nowo-ui-badge nowo-ui-badge--{{ connection == 'default' ? 'success' : 'primary' }}">{{ connection }}</span></h2>
        <a href="{{ path('customer_new', {connection: connection}) }}" class="nowo-ui-btn nowo-ui-btn--primary">Create New Customer</a>
    </div>
    <div class="nowo-ui-card__body">
        {% if customers|length > 0 %}
            <div class="nowo-ui-table-wrap">
                <table class="nowo-ui-table nowo-ui-table--striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Reference Code</th>
                            {% if hasAnonymizedColumn|default(false) %}
                            <th>Anonymized</th>
                            {% endif %}
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for customer in customers %}
                            <tr>
                                <td>{{ customer.id }}</td>
                                <td>{{ customer.email }}</td>
                                <td>{{ customer.name }}</td>
                                <td><span class="nowo-ui-badge nowo-ui-badge--neutral">{{ customer.status }}</span></td>
                                <td>{{ customer.referenceCode ?? '-' }}</td>
                                {% if hasAnonymizedColumn|default(false) %}
                                <td>
                                    {% if customer.anonymized|default(false) %}
                                    {% include '_anonymized_badge.html.twig' with {value: customer.anonymized|default(false)} %}
                                {% endif %}
                                </td>
                                {% endif %}
                                <td>
                                    <div class="nowo-ui-row-actions">
                                        <a href="{{ path('customer_show', {connection: connection, id: customer.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Show</a>
                                        <a href="{{ path('customer_edit', {connection: connection, id: customer.id}) }}" class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline">Edit</a>
                                        {% set delete_form = demo_delete_form('customer_delete', {connection: connection, id: customer.id}, customer.id, 'Are you sure?') %}
                                        {{ form_start(delete_form) }}
                                        {{ form_end(delete_form) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <p class="nowo-ui-muted">No customers found. <a href="{{ path('customer_new', {connection: connection}) }}">Create the first one</a>.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
