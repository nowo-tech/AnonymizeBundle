<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\AnonymizeBundle\Tests\Integration\Ddd\Domain\Patient" table="ddd_patient">
        <id name="id" type="string" column="id" length="36"/>
        <field name="email" type="string" column="email" length="180"/>
        <field name="fullName" type="string" column="full_name" length="120"/>
        <field name="status" type="string" column="status" length="20"/>
        <field name="anonymized" type="boolean" column="anonymized"/>
        <embedded name="contact" class="Nowo\AnonymizeBundle\Tests\Integration\Ddd\Domain\ContactDetails" column-prefix="contact_"/>
    </entity>
</doctrine-mapping>
